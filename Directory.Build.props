<Project>
  <!-- SDK 10.0.402 otherwise selects ILCompiler 10.0.13. Pin native helpers to
       the patched pack for GHSA-p3jp-9v83-76w9 without changing the SDK/TFM or
       framework-dependent tools' installed-runtime compatibility. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <RuntimeFrameworkVersion>10.0.14</RuntimeFrameworkVersion>
  </PropertyGroup>
</Project>
