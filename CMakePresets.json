{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "arm-stress",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm-stress",
      "toolchainFile": "${sourceDir}/cmake/arm-mps2-toolchain.cmake",
      "cacheVariables": {
        "RTOS_TARGET_ID": "qemu-mps2-m3",
        "RTOS_STACK_WATERMARK": "ON",
        "RTOS_APPLICATION": "examples/arm_stress.cpp",
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "RTOS_BUILD_FIRMWARE": "ON",
        "RTOS_ARM_SIMULATION": "ON",
        "RTOS_MAX_THREADS": "9",
        "RTOS_IDLE_STACK_BYTES": "1024",
        "RTOS_BOOT_STACK_BYTES": "4096",
        "RTOS_SYNC": "ON",
        "RTOS_LOGGING": "ON",
        "RTOS_ETHERNET": "OFF",
        "RTOS_WEB": "OFF"
      }
    },
    {
      "name": "uart",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/uart",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/axi_uart_threads.cpp",
        "RTOS_MAX_THREADS": "3",
        "RTOS_IDLE_STACK_BYTES": "512",
        "RTOS_BOOT_STACK_BYTES": "4096",
        "RTOS_METRICS": "ON",
        "RTOS_STACK_GUARD": "ON",
        "RTOS_ROUND_ROBIN": "ON",
        "RTOS_SYNC": "ON",
        "RTOS_LOGGING": "ON",
        "RTOS_WEB": "OFF",
        "RTOS_ETHERNET": "OFF"
      }
    },
    {
      "name": "nano",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/nano",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/nano.cpp",
        "RTOS_MAX_THREADS": "1",
        "RTOS_IDLE_STACK_BYTES": "512",
        "RTOS_METRICS": "OFF",
        "RTOS_STACK_GUARD": "OFF",
        "RTOS_STACK_WATERMARK": "OFF",
        "RTOS_ROUND_ROBIN": "OFF",
        "RTOS_ETHERNET": "OFF",
        "RTOS_WEB": "OFF",
        "RTOS_STORAGE": "OFF",
        "RTOS_SYNC": "OFF",
        "RTOS_LOGGING": "OFF"
      }
    },
    {
      "name": "host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "minimal",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/minimal",
      "cacheVariables": {
        "RTOS_METRICS": "OFF",
        "RTOS_STACK_GUARD": "OFF",
        "RTOS_ROUND_ROBIN": "OFF",
        "RTOS_ETHERNET": "OFF"
      }
    },
    {
      "name": "riscue",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/riscue",
      "toolchainFile": "${sourceDir}/cmake/riscue-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "RTOS_BUILD_FIRMWARE": "ON"
      }
    },
    {
      "name": "sync",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/sync",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/sync.cpp",
        "RTOS_SYNC": "ON",
        "RTOS_LOGGING": "OFF",
        "RTOS_WEB": "OFF",
        "RTOS_ETHERNET": "OFF"
      }
    },
    {
      "name": "logging",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/logging",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/sync.cpp",
        "RTOS_SYNC": "ON",
        "RTOS_LOGGING": "ON",
        "RTOS_WEB": "OFF",
        "RTOS_ETHERNET": "OFF"
      }
    },
    {
      "name": "host-sync",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/host-sync",
      "cacheVariables": {
        "RTOS_SYNC": "ON",
        "RTOS_ETHERNET": "OFF",
        "RTOS_WEB": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "arm-stress",
      "configurePreset": "arm-stress"
    },
    {
      "name": "uart",
      "configurePreset": "uart"
    },
    {
      "name": "nano",
      "configurePreset": "nano"
    },
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "minimal",
      "configurePreset": "minimal"
    },
    {
      "name": "riscue",
      "configurePreset": "riscue"
    },
    {
      "name": "sync",
      "configurePreset": "sync"
    },
    {
      "name": "logging",
      "configurePreset": "logging"
    },
    {
      "name": "host-sync",
      "configurePreset": "host-sync"
    }
  ],
  "testPresets": [
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "minimal",
      "configurePreset": "minimal",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-sync",
      "configurePreset": "host-sync",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
