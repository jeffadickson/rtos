{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-static-services", "inherits": "host",
      "binaryDir": "${sourceDir}/build/static-services",
      "cacheVariables": { "RTOS_STORAGE": "ON", "RTOS_LWIP": "ON", "RTOS_ETHERNET": "ON", "RTOS_ETL_EVALUATION": "ON", "RTOS_WEB": "OFF", "RTOS_INTERPRETER": "ON" }
    },
    {
      "name": "services-rv32-sim", "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/services-firmware",
      "cacheVariables": { "RTOS_APPLICATION": "examples/static_services.cpp", "RTOS_RISCUE_RAM_BYTES": "262144", "RTOS_STORAGE": "ON", "RTOS_LWIP": "ON", "RTOS_ETHERNET": "ON", "RTOS_WEB": "OFF", "RTOS_MAX_THREADS": "2", "RTOS_METRICS": "ON" }
    },
    {
      "name": "atomic-baseline",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/atomic-baseline",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/atomic_stress.cpp",
        "RTOS_SYNC": "ON",
        "RTOS_ZAAMO": "OFF",
        "RTOS_ZAAMO_CAPABLE_RAM": "OFF",
        "RTOS_DMA": "OFF",
        "RTOS_LOGGING": "OFF",
        "RTOS_ETHERNET": "OFF",
        "RTOS_WEB": "OFF",
        "RTOS_MAX_THREADS": "4",
        "RTOS_IDLE_STACK_BYTES": "1024",
        "RTOS_STACK_GUARD": "ON",
        "RTOS_ROUND_ROBIN": "ON"
      }
    },
    {
      "name": "atomic-zaamo",
      "inherits": "atomic-baseline",
      "binaryDir": "${sourceDir}/build/atomic-zaamo",
      "cacheVariables": { "RTOS_ZAAMO": "ON", "RTOS_ZAAMO_CAPABLE_RAM": "ON" }
    },
    {
      "name": "overnight-stress",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/overnight-stress",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/overnight_stress.cpp",
        "RTOS_SOAK_CLOCK_HZ": "100000000",
        "RTOS_MAX_THREADS": "6",
        "RTOS_SYNC": "ON",
        "RTOS_DMA": "OFF",
        "RTOS_LOGGING": "OFF",
        "RTOS_ETHERNET": "OFF",
        "RTOS_WEB": "OFF",
        "RTOS_METRICS": "ON",
        "RTOS_STACK_GUARD": "ON",
        "RTOS_STACK_WATERMARK": "ON",
        "RTOS_ROUND_ROBIN": "ON",
        "RTOS_IDLE_STACK_BYTES": "1024"
      }
    },
    {
      "name": "host-asan",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/host-asan",
      "cacheVariables": { "RTOS_HOST_SANITIZERS": "ON", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "host-valgrind",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/host-valgrind",
      "cacheVariables": { "RTOS_HOST_VALGRIND": "ON" }
    },
    {
      "name": "arm-stress-wrap",
      "inherits": "arm-stress",
      "binaryDir": "${sourceDir}/build/arm-stress-wrap",
      "cacheVariables": { "RTOS_ARM_TIMER_INITIAL": "256" }
    },
    {
      "name": "arm-stress-fast",
      "inherits": "arm-stress",
      "binaryDir": "${sourceDir}/build/arm-stress-fast",
      "cacheVariables": { "RTOS_TICK_HZ": "2000", "RTOS_STRESS_QUEUE_CAPACITY": "3" }
    },
    {
      "name": "arm-stress-no-watermark",
      "inherits": "arm-stress",
      "binaryDir": "${sourceDir}/build/arm-stress-no-watermark",
      "cacheVariables": { "RTOS_STACK_WATERMARK": "OFF" }
    },
    {
      "name": "arm-stress-no-guards",
      "inherits": "arm-stress",
      "binaryDir": "${sourceDir}/build/arm-stress-no-guards",
      "cacheVariables": { "RTOS_STACK_GUARD": "OFF" }
    },
    {
      "name": "arm-stress",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm-stress",
      "toolchainFile": "${sourceDir}/cmake/arm-mps2-toolchain.cmake",
      "cacheVariables": {
        "RTOS_TARGET_ID": "qemu-mps2-m3",
        "RTOS_ARM_STRESS_WITNESS": "ON",
        "RTOS_STACK_WATERMARK": "ON",
        "RTOS_APPLICATION": "examples/arm_stress.cpp",
        "CMAKE_BUILD_TYPE": "Release",
        "RTOS_BUILD_FIRMWARE": "ON",
        "RTOS_ARM_SIMULATION": "ON",
        "RTOS_MAX_THREADS": "9",
        "RTOS_IDLE_STACK_BYTES": "1024",
        "RTOS_BOOT_STACK_BYTES": "4096",
        "RTOS_SYNC": "ON",
        "RTOS_LOGGING": "ON",
        "RTOS_ETHERNET": "OFF",
        "RTOS_WEB": "OFF"
      }
    },
    {
      "name": "uart",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/uart",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/axi_uart_threads.cpp",
        "RTOS_MAX_THREADS": "3",
        "RTOS_IDLE_STACK_BYTES": "512",
        "RTOS_BOOT_STACK_BYTES": "4096",
        "RTOS_METRICS": "ON",
        "RTOS_STACK_GUARD": "ON",
        "RTOS_ROUND_ROBIN": "ON",
        "RTOS_SYNC": "ON",
        "RTOS_LOGGING": "ON",
        "RTOS_WEB": "OFF",
        "RTOS_ETHERNET": "OFF"
      }
    },
    {
      "name": "nano",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/nano",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/nano.cpp",
        "RTOS_DMA": "OFF",
        "RTOS_MAX_THREADS": "1",
        "RTOS_IDLE_STACK_BYTES": "512",
        "RTOS_METRICS": "OFF",
        "RTOS_STACK_GUARD": "OFF",
        "RTOS_STACK_WATERMARK": "OFF",
        "RTOS_ROUND_ROBIN": "OFF",
        "RTOS_ETHERNET": "OFF",
        "RTOS_WEB": "OFF",
        "RTOS_STORAGE": "OFF",
        "RTOS_SYNC": "OFF",
        "RTOS_LOGGING": "OFF"
      }
    },
    {
      "name": "host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "minimal",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/minimal",
      "cacheVariables": {
        "RTOS_METRICS": "OFF",
        "RTOS_STACK_GUARD": "OFF",
        "RTOS_ROUND_ROBIN": "OFF",
        "RTOS_ETHERNET": "OFF"
      }
    },
    {
      "name": "riscue",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/riscue",
      "toolchainFile": "${sourceDir}/cmake/riscue-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "RTOS_BUILD_FIRMWARE": "ON"
      }
    },
    {
      "name": "sync",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/sync",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/sync.cpp",
        "RTOS_SYNC": "ON",
        "RTOS_LOGGING": "OFF",
        "RTOS_WEB": "OFF",
        "RTOS_ETHERNET": "OFF"
      }
    },
    {
      "name": "logging",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/logging",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/sync.cpp",
        "RTOS_SYNC": "ON",
        "RTOS_LOGGING": "ON",
        "RTOS_WEB": "OFF",
        "RTOS_ETHERNET": "OFF"
      }
    },
    {
      "name": "host-sync",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/host-sync",
      "cacheVariables": {
        "RTOS_SYNC": "ON",
        "RTOS_ETHERNET": "OFF",
        "RTOS_WEB": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "host-static-services", "configurePreset": "host-static-services" },
    { "name": "services-rv32-sim", "configurePreset": "services-rv32-sim" },
    { "name": "atomic-baseline", "configurePreset": "atomic-baseline" },
    { "name": "atomic-zaamo", "configurePreset": "atomic-zaamo" },
    { "name": "overnight-stress", "configurePreset": "overnight-stress" },
    { "name": "host-asan", "configurePreset": "host-asan" },
    { "name": "host-valgrind", "configurePreset": "host-valgrind" },
    { "name": "arm-stress-wrap", "configurePreset": "arm-stress-wrap" },
    { "name": "arm-stress-fast", "configurePreset": "arm-stress-fast" },
    { "name": "arm-stress-no-watermark", "configurePreset": "arm-stress-no-watermark" },
    { "name": "arm-stress-no-guards", "configurePreset": "arm-stress-no-guards" },
    {
      "name": "arm-stress",
      "configurePreset": "arm-stress"
    },
    {
      "name": "uart",
      "configurePreset": "uart"
    },
    {
      "name": "nano",
      "configurePreset": "nano"
    },
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "minimal",
      "configurePreset": "minimal"
    },
    {
      "name": "riscue",
      "configurePreset": "riscue"
    },
    {
      "name": "sync",
      "configurePreset": "sync"
    },
    {
      "name": "logging",
      "configurePreset": "logging"
    },
    {
      "name": "host-sync",
      "configurePreset": "host-sync"
    }
  ],
  "testPresets": [
    { "name": "host-asan", "configurePreset": "host-asan", "output": { "outputOnFailure": true } },
    { "name": "host-valgrind", "configurePreset": "host-valgrind", "filter": { "include": { "label": "memcheck" } }, "output": { "outputOnFailure": true } },
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "minimal",
      "configurePreset": "minimal",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-sync",
      "configurePreset": "host-sync",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
