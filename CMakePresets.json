{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 22,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "host-asan",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/host-asan",
      "cacheVariables": { "RTOS_HOST_SANITIZERS": "ON", "CMAKE_CXX_COMPILER": "clang++" }
    },
    {
      "name": "host-valgrind",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/host-valgrind",
      "cacheVariables": { "RTOS_HOST_VALGRIND": "ON" }
    },
    {
      "name": "arm-stress-wrap",
      "inherits": "arm-stress",
      "binaryDir": "${sourceDir}/build/arm-stress-wrap",
      "cacheVariables": { "RTOS_ARM_TIMER_INITIAL": "256" }
    },
    {
      "name": "arm-stress-fast",
      "inherits": "arm-stress",
      "binaryDir": "${sourceDir}/build/arm-stress-fast",
      "cacheVariables": { "RTOS_TICK_HZ": "2000", "RTOS_STRESS_QUEUE_CAPACITY": "3" }
    },
    {
      "name": "arm-stress-no-watermark",
      "inherits": "arm-stress",
      "binaryDir": "${sourceDir}/build/arm-stress-no-watermark",
      "cacheVariables": { "RTOS_STACK_WATERMARK": "OFF" }
    },
    {
      "name": "arm-stress-no-guards",
      "inherits": "arm-stress",
      "binaryDir": "${sourceDir}/build/arm-stress-no-guards",
      "cacheVariables": { "RTOS_STACK_GUARD": "OFF" }
    },
    {
      "name": "arm-stress",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm-stress",
      "toolchainFile": "${sourceDir}/cmake/arm-mps2-toolchain.cmake",
      "cacheVariables": {
        "RTOS_TARGET_ID": "qemu-mps2-m3",
        "RTOS_ARM_STRESS_WITNESS": "ON",
        "RTOS_STACK_WATERMARK": "ON",
        "RTOS_APPLICATION": "examples/arm_stress.cpp",
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "RTOS_BUILD_FIRMWARE": "ON",
        "RTOS_ARM_SIMULATION": "ON",
        "RTOS_MAX_THREADS": "9",
        "RTOS_IDLE_STACK_BYTES": "1024",
        "RTOS_BOOT_STACK_BYTES": "4096",
        "RTOS_SYNC": "ON",
        "RTOS_LOGGING": "ON",
        "RTOS_ETHERNET": "OFF",
        "RTOS_WEB": "OFF"
      }
    },
    {
      "name": "arm-cameo-embed",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/arm-cameo-embed",
      "toolchainFile": "${sourceDir}/cmake/arm-mps2-toolchain.cmake",
      "cacheVariables": {
        "RTOS_TARGET_ID": "qemu-mps2-m3",
        "RTOS_APPLICATION": "examples/cameo_embed_arm.cpp",
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "RTOS_BUILD_FIRMWARE": "ON",
        "RTOS_ARM_SIMULATION": "ON",
        "RTOS_MAX_THREADS": "3",
        "RTOS_IDLE_STACK_BYTES": "1024",
        "RTOS_BOOT_STACK_BYTES": "4096",
        "RTOS_SYNC": "ON",
        "RTOS_LOGGING": "OFF",
        "RTOS_TRACE": "ON",
        "RTOS_MONITOR": "ON",
        "RTOS_CAMEO_EMBED": "ON",
        "RTOS_ETHERNET": "OFF",
        "RTOS_WEB": "OFF"
      }
    },
    {
      "name": "uart",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/uart",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/axi_uart_threads.cpp",
        "RTOS_MAX_THREADS": "3",
        "RTOS_IDLE_STACK_BYTES": "512",
        "RTOS_BOOT_STACK_BYTES": "4096",
        "RTOS_METRICS": "ON",
        "RTOS_STACK_GUARD": "ON",
        "RTOS_ROUND_ROBIN": "ON",
        "RTOS_SYNC": "ON",
        "RTOS_LOGGING": "ON",
        "RTOS_WEB": "OFF",
        "RTOS_ETHERNET": "OFF"
      }
    },
    {
      "name": "nano",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/nano",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/nano.cpp",
        "RTOS_DMA": "OFF",
        "RTOS_MAX_THREADS": "1",
        "RTOS_IDLE_STACK_BYTES": "512",
        "RTOS_METRICS": "OFF",
        "RTOS_STACK_GUARD": "OFF",
        "RTOS_STACK_WATERMARK": "OFF",
        "RTOS_ROUND_ROBIN": "OFF",
        "RTOS_ETHERNET": "OFF",
        "RTOS_WEB": "OFF",
        "RTOS_STORAGE": "OFF",
        "RTOS_SYNC": "OFF",
        "RTOS_LOGGING": "OFF"
      }
    },
    {
      "name": "host",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "minimal",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/minimal",
      "cacheVariables": {
        "RTOS_METRICS": "OFF",
        "RTOS_STACK_GUARD": "OFF",
        "RTOS_ROUND_ROBIN": "OFF",
        "RTOS_ETHERNET": "OFF"
      }
    },
    {
      "name": "riscue",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/riscue",
      "toolchainFile": "${sourceDir}/cmake/riscue-toolchain.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "MinSizeRel",
        "RTOS_BUILD_FIRMWARE": "ON"
      }
    },
    {
      "name": "sync",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/sync",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/sync.cpp",
        "RTOS_SYNC": "ON",
        "RTOS_LOGGING": "OFF",
        "RTOS_WEB": "OFF",
        "RTOS_ETHERNET": "OFF"
      }
    },
    {
      "name": "logging",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/logging",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/sync.cpp",
        "RTOS_SYNC": "ON",
        "RTOS_LOGGING": "ON",
        "RTOS_WEB": "OFF",
        "RTOS_ETHERNET": "OFF"
      }
    },
    {
      "name": "host-sync",
      "inherits": "host",
      "binaryDir": "${sourceDir}/build/host-sync",
      "cacheVariables": {
        "RTOS_SYNC": "ON",
        "RTOS_ETHERNET": "OFF",
        "RTOS_WEB": "OFF"
      }
    },
    {
      "name": "arm-stress-mpu",
      "inherits": "arm-stress",
      "binaryDir": "${sourceDir}/build/arm-stress-mpu",
      "cacheVariables": {
        "RTOS_HW_PROTECT": "ON",
        "RTOS_BUDGET_WATCHDOG": "ON"
      }
    },
    {
      "name": "flagship-riscue",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/flagship-riscue",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/flagship_stateforge.cpp",
        "RTOS_MAX_THREADS": "4",
        "RTOS_IDLE_STACK_BYTES": "512",
        "RTOS_BOOT_STACK_BYTES": "2048",
        "RTOS_SYNC": "ON",
        "RTOS_LOGGING": "ON",
        "RTOS_WEB": "ON",
        "RTOS_ETHERNET": "OFF",
        "RTOS_BUDGET_WATCHDOG": "ON"
      }
    },
    {
      "name": "flagship-hwsched",
      "inherits": "flagship-riscue",
      "binaryDir": "${sourceDir}/build/flagship-hwsched",
      "cacheVariables": {
        "RTOS_HW_SCHED": "ON"
      }
    },
    {
      "name": "flagship-banked",
      "inherits": "flagship-hwsched",
      "binaryDir": "${sourceDir}/build/flagship-banked",
      "cacheVariables": {
        "RTOS_RISCUE_BANKED": "ON",
        "RTOS_RISCUE_BANKS": "8"
      }
    },
    {
      "name": "storage-riscue",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/storage-riscue",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/storage_demo.cpp",
        "RTOS_MAX_THREADS": "4",
        "RTOS_IDLE_STACK_BYTES": "512",
        "RTOS_BOOT_STACK_BYTES": "2048",
        "RTOS_SYNC": "ON",
        "RTOS_STORAGE": "ON",
        "RTOS_WEB": "OFF",
        "RTOS_ETHERNET": "OFF"
      }
    },
    {
      "name": "flight-riscue",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/flight-riscue",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/flight_demo.cpp",
        "RTOS_MAX_THREADS": "6",
        "RTOS_IDLE_STACK_BYTES": "512",
        "RTOS_BOOT_STACK_BYTES": "2048",
        "RTOS_FLIGHT_BUILD": "ON",
        "RTOS_SYNC": "ON",
        "RTOS_STORAGE": "ON",
        "RTOS_BOOT": "ON",
        "RTOS_RM_PERIOD": "ON",
        "RTOS_POOL": "ON",
        "RTOS_WORKQUEUE": "ON",
        "RTOS_CLOCK_EPOCH": "ON",
        "RTOS_TICKLESS": "ON",
        "RTOS_TOPIC": "ON",
        "RTOS_TRACE": "ON",
        "RTOS_WEB": "OFF",
        "RTOS_ETHERNET": "OFF"
      }
    },
    {
      "name": "bench-riscue",
      "inherits": "riscue",
      "binaryDir": "${sourceDir}/build/bench-riscue",
      "cacheVariables": {
        "RTOS_APPLICATION": "examples/bench_demo.cpp",
        "RTOS_MAX_THREADS": "6",
        "RTOS_IDLE_STACK_BYTES": "512",
        "RTOS_BOOT_STACK_BYTES": "2048",
        "RTOS_FLIGHT_BUILD": "OFF",
        "RTOS_SYNC": "ON",
        "RTOS_STORAGE": "OFF",
        "RTOS_BOOT": "ON",
        "RTOS_RM_PERIOD": "ON",
        "RTOS_POOL": "ON",
        "RTOS_WORKQUEUE": "ON",
        "RTOS_CLOCK_EPOCH": "ON",
        "RTOS_TOPIC": "ON",
        "RTOS_TRACE": "ON",
        "RTOS_MONITOR": "ON",
        "RTOS_SCRIPT": "ON",
        "RTOS_ELF_LOADER": "ON",
        "RTOS_AMP": "ON",
        "RTOS_WEB": "OFF",
        "RTOS_ETHERNET": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "host-asan", "configurePreset": "host-asan" },
    { "name": "host-valgrind", "configurePreset": "host-valgrind" },
    { "name": "arm-stress-wrap", "configurePreset": "arm-stress-wrap" },
    { "name": "arm-stress-fast", "configurePreset": "arm-stress-fast" },
    { "name": "arm-stress-no-watermark", "configurePreset": "arm-stress-no-watermark" },
    { "name": "arm-stress-no-guards", "configurePreset": "arm-stress-no-guards" },
    { "name": "arm-stress-mpu", "configurePreset": "arm-stress-mpu" },
    {
      "name": "arm-stress",
      "configurePreset": "arm-stress"
    },
    {
      "name": "arm-cameo-embed",
      "configurePreset": "arm-cameo-embed"
    },
    {
      "name": "uart",
      "configurePreset": "uart"
    },
    {
      "name": "nano",
      "configurePreset": "nano"
    },
    {
      "name": "host",
      "configurePreset": "host"
    },
    {
      "name": "minimal",
      "configurePreset": "minimal"
    },
    {
      "name": "riscue",
      "configurePreset": "riscue"
    },
    {
      "name": "sync",
      "configurePreset": "sync"
    },
    {
      "name": "logging",
      "configurePreset": "logging"
    },
    {
      "name": "host-sync",
      "configurePreset": "host-sync"
    },
    { "name": "flagship-riscue", "configurePreset": "flagship-riscue" },
    { "name": "flagship-hwsched", "configurePreset": "flagship-hwsched" },
    { "name": "flagship-banked", "configurePreset": "flagship-banked" },
    { "name": "storage-riscue", "configurePreset": "storage-riscue" },
    { "name": "flight-riscue", "configurePreset": "flight-riscue" },
    { "name": "bench-riscue", "configurePreset": "bench-riscue" }
  ],
  "testPresets": [
    { "name": "host-asan", "configurePreset": "host-asan", "output": { "outputOnFailure": true } },
    { "name": "host-valgrind", "configurePreset": "host-valgrind", "filter": { "include": { "label": "memcheck" } }, "output": { "outputOnFailure": true } },
    {
      "name": "host",
      "configurePreset": "host",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "minimal",
      "configurePreset": "minimal",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "host-sync",
      "configurePreset": "host-sync",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
