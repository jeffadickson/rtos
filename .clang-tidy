# Small correctness-focused baseline. Expand after reviewing findings, not with
# blanket exclusions or automatic source rewrites. Compiler errors remain fatal.
Checks: >-
  -*,
  clang-analyzer-core.*,clang-analyzer-cplusplus.*,clang-analyzer-deadcode.*,
  clang-analyzer-unix.*,
  bugprone-sizeof-expression,bugprone-suspicious-semicolon,
  bugprone-misplaced-widening-cast,bugprone-undefined-memory-manipulation,
  bugprone-use-after-move,modernize-use-nullptr,modernize-use-override,
  performance-move-const-arg
WarningsAsErrors: '*'
HeaderFilterRegex: '.*[/\\](include|src|tests|generated|ports)[/\\].*'
FormatStyle: none
