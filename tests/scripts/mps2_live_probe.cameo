export fn probe_hw(scratch_addr: integer) -> integer {
    let t0 = cmsdk_timer0_open(CMSDK_TIMER0_BASE)
    let enabled = cmsdk_timer0_get_ctrl_enable(t0)
    dbg.assert(enabled == 1, 10)
    let v1 = cmsdk_timer0_read_value(t0)
    let v2 = cmsdk_timer0_read_value(t0)
    dbg.assert(v1 != v2, 11)

    let ok_tr = axi.trace_enable(true)
    dbg.assert(ok_tr, 12)
    let hits_before = axi.watch_hits()
    let wp = axi.watch(scratch_addr, 4, 2)
    dbg.assert(wp >= 0, 13)

    let p = ptr(scratch_addr)
    let w_ok = p.write32_at(0, 0x12345678)
    dbg.assert(w_ok, 14)
    let _, rmw_ok = p.rmw_bits32_at(0, 8, 8, 0xAB)
    dbg.assert(rmw_ok, 15)
    let readback = p.read32_at(0)
    dbg.expect_eq(readback, 0x1234AB78, 16)
    dbg.expect_eq(axi.watch_hits() - hits_before, 2, 17)
    let _ = axi.unwatch(wp)
    return readback
}
