<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Generated Dafny C# uses Dafny's recommended compiler switches for unannotated generated code. -->
    <NoWarn>CS0162;CS0164;CS0168;CS0183;CS0219;CS0436;CS1591;CS1717;CS1718;CS8600;CS8601;CS8602;CS8603;CS8604;CS8618;CS8625;CS8765</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../HostProcess.cs" Link="HostProcess.cs" />
    <Compile Include="$(GeneratedDafnyCs)" Condition="'$(GeneratedDafnyCs)' != ''" Link="SchedulerProof.generated.cs" />
    <Reference Include="DafnyRuntime" Condition="'$(DafnyRuntimeDll)' != ''">
      <HintPath>$(DafnyRuntimeDll)</HintPath>
    </Reference>
  </ItemGroup>
</Project>
