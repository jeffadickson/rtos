# Compiler scaffold for the classic 32-bit ISA, not an implemented firmware port.
# Supply values from the exact Vivado/Vitis hardware export; do not reuse RV32 flags.
set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR microblaze)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(MICROBLAZE_TOOLCHAIN_PREFIX "" CACHE STRING "Exact SDK compiler prefix, including trailing hyphen")
set(MICROBLAZE_ENDIANNESS "" CACHE STRING "little or big, matching the hardware export")
set(MICROBLAZE_CPU_FLAGS "" CACHE STRING "Explicit SDK CPU feature flags, including -mcpu and multiplier/divider policy")
if(NOT MICROBLAZE_TOOLCHAIN_PREFIX OR NOT MICROBLAZE_CPU_FLAGS)
  message(FATAL_ERROR "Provide MICROBLAZE_TOOLCHAIN_PREFIX and MICROBLAZE_CPU_FLAGS from the hardware SDK")
endif()
if(MICROBLAZE_ENDIANNESS STREQUAL "little")
  set(microblaze_endian_flag -mlittle-endian)
elseif(MICROBLAZE_ENDIANNESS STREQUAL "big")
  set(microblaze_endian_flag -mbig-endian)
else()
  message(FATAL_ERROR "MICROBLAZE_ENDIANNESS must explicitly match hardware: little or big")
endif()
set(CMAKE_CXX_COMPILER "${MICROBLAZE_TOOLCHAIN_PREFIX}g++")
set(CMAKE_ASM_COMPILER "${MICROBLAZE_TOOLCHAIN_PREFIX}gcc")
set(CMAKE_NM "${MICROBLAZE_TOOLCHAIN_PREFIX}nm" CACHE FILEPATH "nm")
set(CMAKE_SIZE "${MICROBLAZE_TOOLCHAIN_PREFIX}size" CACHE FILEPATH "size")
set(CMAKE_CXX_FLAGS_INIT "${microblaze_endian_flag} ${MICROBLAZE_CPU_FLAGS} -ffreestanding -fno-builtin -fno-exceptions -fno-rtti -fno-threadsafe-statics -fno-use-cxa-atexit")
set(CMAKE_ASM_FLAGS_INIT "${microblaze_endian_flag} ${MICROBLAZE_CPU_FLAGS}")
