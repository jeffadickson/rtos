# Dependencies are resolved only for enabled features. Immutable upstream commits
# may be supplied offline through FetchContent's standard SOURCE_DIR overrides.
include(FetchContent)
if(RTOS_VIRTIO_NET)
  add_library(rtos_virtio_net STATIC src/virtio_net.cpp)
  target_link_libraries(rtos_virtio_net PUBLIC nexrt::ethernet)
  add_library(nexrt::virtio_net ALIAS rtos_virtio_net)
  if(NOT RTOS_BUILD_FIRMWARE)
    add_executable(virtio_net_test tests/virtio_net.cpp)
    target_link_libraries(virtio_net_test PRIVATE nexrt::virtio_net)
    if(MSVC)
      target_compile_options(virtio_net_test PRIVATE /W4 /WX /UNDEBUG)
    else()
    target_compile_options(virtio_net_test PRIVATE -Wall -Wextra -Werror -UNDEBUG)
    endif()
    add_test(NAME virtio_net COMMAND virtio_net_test)
  endif()
endif()
if(RTOS_BUILD_FIRMWARE AND (RTOS_STORAGE OR RTOS_LWIP))
  find_path(RTOS_C_LIBRARY_INCLUDE string.h HINTS /usr/include/newlib
    ${CMAKE_SOURCE_DIR}/build/newlib-headers/usr/include/newlib
    DOC "Freestanding C library headers for third-party C sources" NO_DEFAULT_PATH REQUIRED)
  target_include_directories(rtos_options SYSTEM INTERFACE ${RTOS_C_LIBRARY_INCLUDE})
endif()
if(RTOS_SERVICE_FUZZ)
  add_executable(udp_fuzz tests/udp_fuzz.cpp)
  target_link_libraries(udp_fuzz PRIVATE nexrt::udp)
  target_link_options(udp_fuzz PRIVATE -fsanitize=fuzzer)
endif()
function(nexrt_dependency name repository revision)
  FetchContent_Declare(${name} GIT_REPOSITORY ${repository} GIT_TAG ${revision})
  FetchContent_GetProperties(${name})
  if(NOT ${name}_POPULATED)
    FetchContent_Populate(${name})
  endif()
  set(${name}_SOURCE_DIR "${${name}_SOURCE_DIR}" PARENT_SCOPE)
endfunction()
if(RTOS_STORAGE)
  nexrt_dependency(littlefs https://github.com/littlefs-project/littlefs.git 6cb4e86540eca0d9ba62500a298385c9d863c8be)
  add_library(rtos_littlefs STATIC ${littlefs_SOURCE_DIR}/lfs.c ${littlefs_SOURCE_DIR}/lfs_util.c src/storage.cpp)
  target_include_directories(rtos_littlefs PUBLIC include ${littlefs_SOURCE_DIR})
  if(RTOS_BUILD_FIRMWARE)
    target_include_directories(rtos_littlefs SYSTEM PUBLIC ${RTOS_C_LIBRARY_INCLUDE})
  endif()
  target_compile_definitions(rtos_littlefs PUBLIC LFS_NO_MALLOC LFS_NO_ASSERT LFS_NO_DEBUG LFS_NO_WARN LFS_NO_ERROR)
  add_library(nexrt::littlefs ALIAS rtos_littlefs)
  target_compile_features(rtos_littlefs PUBLIC cxx_std_20)
endif()
if(RTOS_LWIP)
  nexrt_dependency(lwip https://github.com/lwip-tcpip/lwip.git 77dcd25a72509eb83f72b033d219b1d40cd8eb95)
  set(LWIP_DIR ${lwip_SOURCE_DIR})
  # Upstream Filelists.cmake creates additional core/application targets. Avoid
  # importing it: disabled TCP/DNS/IPv6 sources must be absent from this graph.
  # Compile only the selected IPv4/UDP core. TCP, DNS, DHCP, sockets and IPv6
  # are disabled by lwipopts.h and excluded from this source graph as well.
  set(core init def inet_chksum ip mem memp netif pbuf stats sys timeouts udp)
  set(net_sources src/udp.cpp ${LWIP_DIR}/src/netif/ethernet.c)
  foreach(unit IN LISTS core)
    list(APPEND net_sources ${LWIP_DIR}/src/core/${unit}.c)
  endforeach()
  foreach(unit acd etharp icmp ip4 ip4_addr)
    list(APPEND net_sources ${LWIP_DIR}/src/core/ipv4/${unit}.c)
  endforeach()
  add_library(rtos_lwip STATIC ${net_sources})
  target_include_directories(rtos_lwip PUBLIC include include/lwip ${LWIP_DIR}/src/include)
  target_link_libraries(rtos_lwip PUBLIC nexrt::ethernet)
  add_library(nexrt::udp ALIAS rtos_lwip)
  if(NOT RTOS_BUILD_FIRMWARE)
    add_executable(udp_address_test tests/udp_address.cpp)
    target_link_libraries(udp_address_test PRIVATE nexrt::udp)
    if(MSVC)
      target_compile_options(udp_address_test PRIVATE /W4 /WX /UNDEBUG)
    else()
    target_compile_options(udp_address_test PRIVATE -Wall -Wextra -Werror -UNDEBUG)
    endif()
    add_test(NAME udp_address COMMAND udp_address_test)
  endif()
endif()
foreach(service rtos_littlefs rtos_lwip)
  if(TARGET ${service})
    if(MSVC)
      target_compile_options(${service} PRIVATE /Gy /Gw)
    else()
      target_compile_options(${service} PRIVATE -ffunction-sections -fdata-sections)
      target_compile_options(${service} PRIVATE $<$<CONFIG:Release>:-O3;-ftree-loop-vectorize;-ftree-slp-vectorize>)
    endif()
    if(RTOS_SERVICE_COVERAGE)
      if(RTOS_BUILD_FIRMWARE OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
        message(FATAL_ERROR "Service coverage requires native GNU compilation")
      endif()
      target_compile_options(${service} PUBLIC --coverage -O0 -g)
      target_link_options(${service} PUBLIC --coverage)
    endif()
  endif()
endforeach()
if(RTOS_ETL_EVALUATION AND NOT RTOS_BUILD_FIRMWARE)
  nexrt_dependency(etl https://github.com/ETLCPP/etl.git c882a9c5004d546bb23bd0f758ae40cd57d1b063)
  add_executable(etl_evaluation tests/etl_evaluation.cpp)
  target_include_directories(etl_evaluation PRIVATE ${etl_SOURCE_DIR}/include)
  if(MSVC)
    target_compile_options(etl_evaluation PRIVATE /W4 /WX /UNDEBUG /GR-)
  else()
    target_compile_options(etl_evaluation PRIVATE -Wall -Wextra -Werror -UNDEBUG -fno-exceptions -fno-rtti)
  endif()
  add_test(NAME etl_evaluation COMMAND etl_evaluation)
endif()
if(NOT RTOS_BUILD_FIRMWARE)
  foreach(feature STORAGE LWIP)
    if(RTOS_${feature})
      if(feature STREQUAL "STORAGE")
        set(test_name littlefs_service)
        set(test_source tests/static_services.cpp)
        set(test_library nexrt::littlefs)
      else()
        set(test_name udp_service)
        set(test_source tests/udp.cpp)
        set(test_library nexrt::udp)
      endif()
      add_executable(${test_name} ${test_source})
      target_link_libraries(${test_name} PRIVATE ${test_library})
      if(MSVC)
        target_compile_options(${test_name} PRIVATE /W4 /WX /UNDEBUG)
      else()
        target_compile_options(${test_name} PRIVATE -Wall -Wextra -Werror -UNDEBUG)
      endif()
      add_test(NAME ${test_name} COMMAND ${test_name})
    endif()
  endforeach()
endif()
# Evaluation only: caller supplies an existing Boost header tree. This never
# resolves/downloads Boost for firmware or normal host configurations.
option(RTOS_BOOST_EVALUATION "Build host-only Boost static-capacity evaluation" OFF)
if(RTOS_BOOST_EVALUATION)
  if(RTOS_BUILD_FIRMWARE)
    message(FATAL_ERROR "Boost evaluation is host-only")
  endif()
  find_path(NXR_BOOST_INCLUDE boost/version.hpp REQUIRED)
  add_executable(boost_static_evaluation tests/boost_static_evaluation.cpp)
  target_include_directories(boost_static_evaluation SYSTEM PRIVATE ${NXR_BOOST_INCLUDE})
  if(MSVC)
    target_compile_options(boost_static_evaluation PRIVATE /W4 /WX /UNDEBUG)
  else()
    target_compile_options(boost_static_evaluation PRIVATE -Wall -Wextra -Werror -UNDEBUG)
  endif()
  add_test(NAME boost_static_evaluation COMMAND boost_static_evaluation)
endif()
