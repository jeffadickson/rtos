# Optional developer instrumentation, never an implicit firmware dependency.
option(RTOS_HOST_SANITIZERS "Instrument native host C++ checks with ASan/UBSan" OFF)
option(RTOS_HOST_VALGRIND "Add Memcheck variants of native C++ host checks" OFF)
if(RTOS_HOST_SANITIZERS OR RTOS_HOST_VALGRIND)
  if(RTOS_BUILD_FIRMWARE OR CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "Host memory tools cannot instrument firmware")
  endif()
endif()
if(RTOS_HOST_SANITIZERS AND RTOS_HOST_VALGRIND)
  message(FATAL_ERROR "Use separate sanitizer and Valgrind build directories")
endif()
if(RTOS_HOST_SANITIZERS)
  if(NOT CMAKE_CXX_COMPILER_ID MATCHES "GNU|Clang" OR MSVC)
    message(FATAL_ERROR "ASan/UBSan host option requires a GNU-style GCC or Clang compiler")
  endif()
  add_compile_options(-fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=all)
  add_link_options(-fsanitize=address,undefined -fno-sanitize-recover=all)
endif()
if(RTOS_HOST_VALGRIND)
  find_program(NXR_VALGRIND_EXECUTABLE NAMES valgrind REQUIRED)
  set(NXR_VALGRIND_LIB "" CACHE PATH "Optional relocated Valgrind support directory")
endif()
