  if(NOT CMAKE_CROSSCOMPILING)
    message(FATAL_ERROR "Firmware requires an architecture toolchain file")
  endif()
  if(RTOS_TARGET_ID STREQUAL "qemu-mps2-m3")
    if(NOT CMAKE_SYSTEM_PROCESSOR STREQUAL "cortex-m3")
      message(FATAL_ERROR "qemu-mps2-m3 requires cmake/arm-mps2-toolchain.cmake")
    endif()
    set(nxr_port ports/arm-mps2)
    set(nxr_default_application examples/nano.cpp)
    set(RTOS_ARM_TIMER_INITIAL "4294967295" CACHE STRING "Initial CMSDK countdown; full reload stays 32-bit")
    rtos_decimal(RTOS_ARM_TIMER_INITIAL 1 4294967295)
    target_compile_definitions(rtos_options INTERFACE RTOS_ARM_TIMER_INITIAL=${RTOS_ARM_TIMER_INITIAL}u)
    set(RTOS_STRESS_QUEUE_CAPACITY "8" CACHE STRING "ARM stress copied-message queue slots")
    rtos_decimal(RTOS_STRESS_QUEUE_CAPACITY 1 64)
    option(RTOS_ARM_STRESS_WITNESS "Validation-only timer and interrupted-PC observations" OFF)
    target_compile_definitions(rtos_options INTERFACE RTOS_ARM_STRESS_WITNESS=$<BOOL:${RTOS_ARM_STRESS_WITNESS}>)
  else()
    set(nxr_port ports/riscue)
    set(nxr_default_application examples/blink.cpp)
  endif()
  set(nxr_context_asm ${nxr_port}/context.S)
  if(RTOS_RISCUE_BANKED AND NOT RTOS_TARGET_ID STREQUAL "qemu-mps2-m3")
    set(nxr_context_asm ${nxr_port}/context_banked.S)
  endif()
  add_library(rtos STATIC src/kernel.cpp src/memory.cpp ${nxr_context_asm})
  if(RTOS_TARGET_ID STREQUAL "qemu-mps2-m3")
    target_sources(rtos PRIVATE ${nxr_port}/fault.cpp ${nxr_port}/canaries.S)
  endif()
  target_link_libraries(rtos PUBLIC rtos_options)
  if(RTOS_SYNC)
    target_sources(rtos PRIVATE src/sync.cpp src/mutex.cpp)
  endif()
  if(RTOS_LOGGING)
    target_sources(rtos PRIVATE src/log.cpp)
  endif()
  target_include_directories(rtos PRIVATE ${nxr_port})
  add_library(nexrt::kernel ALIAS rtos)
  if(RTOS_DMA)
    target_link_libraries(rtos_dma PUBLIC rtos gcc)
  endif()
  target_compile_options(rtos PRIVATE -Os -fstack-usage -ffunction-sections -fdata-sections)
  set(RTOS_APPLICATION ${nxr_default_application} CACHE FILEPATH "Application source")
  add_executable(demo ${RTOS_APPLICATION} ${nxr_port}/start.S)
  if(RTOS_TARGET_ID STREQUAL "qemu-mps2-m3")
    target_compile_definitions(demo PRIVATE RTOS_STRESS_QUEUE_CAPACITY=${RTOS_STRESS_QUEUE_CAPACITY})
  endif()
  target_compile_options(demo PRIVATE -fstack-usage)
  if(RTOS_DMA)
    target_link_libraries(demo PRIVATE nexrt::dma)
  endif()
  if(RTOS_WEB)
    target_link_libraries(demo PRIVATE nexrt::web)
  endif()
  if(RTOS_STORAGE)
    target_link_libraries(demo PRIVATE nexrt::storage)
  endif()
  target_link_libraries(demo PRIVATE rtos gcc)
  set_target_properties(demo PROPERTIES SUFFIX .elf)
  target_link_options(demo PRIVATE -nostdlib -T${CMAKE_SOURCE_DIR}/${nxr_port}/link.ld
    -Wl,--defsym=__boot_stack_bytes=${RTOS_BOOT_STACK_BYTES}
    -Wl,--gc-sections,-Map,${CMAKE_BINARY_DIR}/demo.map)
  if(NOT RTOS_TARGET_ID STREQUAL "qemu-mps2-m3")
    target_link_options(demo PRIVATE -Wl,--no-relax)
  endif()
  set_property(TARGET demo APPEND PROPERTY LINK_DEPENDS ${CMAKE_SOURCE_DIR}/${nxr_port}/link.ld)
  set_property(TARGET demo APPEND PROPERTY LINK_DEPENDS ${rtos_tools_OUTPUT})
  add_dependencies(demo rtos_tools)
  add_custom_command(TARGET demo POST_BUILD
    COMMAND ${rtos_tools_COMMAND} audit
      --nm ${CMAKE_NM} --elf $<TARGET_FILE:demo>
    COMMAND ${CMAKE_SIZE} $<TARGET_FILE:demo> VERBATIM)
    add_custom_target(static_contract_check
    COMMAND ${rtos_tools_COMMAND} static-contract
      --cxx ${CMAKE_CXX_COMPILER} --nm ${CMAKE_NM}
      --source-root ${CMAKE_SOURCE_DIR} --build-dir ${CMAKE_BINARY_DIR}/static-contract
      --architecture ${RTOS_TARGET_ID}
      DEPENDS rtos_tools VERBATIM)

if(RTOS_WEB)
    add_executable(web_link_probe examples/web_probe.cpp ${nxr_port}/start.S)
    target_include_directories(web_link_probe PRIVATE generated)
    target_compile_options(web_link_probe PRIVATE -Os)
    target_link_libraries(web_link_probe PRIVATE rtos_web rtos gcc)
    target_link_options(web_link_probe PRIVATE -nostdlib -T${CMAKE_SOURCE_DIR}/${nxr_port}/link.ld -Wl,--gc-sections)
    if(NOT RTOS_TARGET_ID STREQUAL "qemu-mps2-m3")
      target_link_options(web_link_probe PRIVATE -Wl,--no-relax)
    endif()
    target_link_options(web_link_probe PRIVATE -Wl,--defsym=__boot_stack_bytes=${RTOS_BOOT_STACK_BYTES})
    set_target_properties(web_link_probe PROPERTIES SUFFIX .elf)
    add_dependencies(web_link_probe rtos_tools)
    add_custom_command(TARGET web_link_probe POST_BUILD COMMAND ${rtos_tools_COMMAND} audit --nm ${CMAKE_NM} --elf $<TARGET_FILE:web_link_probe> VERBATIM)
endif()
