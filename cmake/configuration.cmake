option(RTOS_BUILD_FIRMWARE "Build selected firmware port (requires toolchain file)" OFF)
option(RTOS_ROUND_ROBIN "Time-slice equal priorities on ticks" ON)
option(RTOS_METRICS "Collect runtime cycles and dispatch counts" ON)
option(RTOS_STACK_GUARD "Check stack-bottom sentinels on dispatch" ON)
option(RTOS_STACK_WATERMARK "Paint stacks at boot and allow budgeted diagnostic scans" OFF)
option(RTOS_ETHERNET "Build static polling Ethernet adapter" ON)
set(RTOS_MAX_THREADS 16 CACHE STRING "Maximum application threads, excluding idle")
set(RTOS_TICK_HZ 1000 CACHE STRING "Default tick rate")
set(RTOS_IDLE_STACK_BYTES 1024 CACHE STRING "Idle stack size")
set(RTOS_BOOT_STACK_BYTES 4096 CACHE STRING "RISCue boot stack reserve; qualify reductions for the application")
set(RTOS_MTIME_ADDRESS 0x0200bff8 CACHE STRING "mtime MMIO address")
set(RTOS_MTIMECMP_ADDRESS 0x02004000 CACHE STRING "mtimecmp MMIO address")

option(RTOS_WEB "Build bounded read-only HTTP component" ON)
option(RTOS_STORAGE "Build boot-static littlefs storage service" OFF)
option(RTOS_LWIP "Build single-owner static lwIP UDP service" OFF)
option(RTOS_ETL_EVALUATION "Build the isolated ETL pool evaluation" OFF)
if(RTOS_ETL_EVALUATION AND RTOS_BUILD_FIRMWARE)
  message(FATAL_ERROR "RTOS_ETL_EVALUATION is host-only")
endif()
option(RTOS_SERVICE_FUZZ "Build LLVM libFuzzer Ethernet input harness" OFF)
if(RTOS_SERVICE_FUZZ)
  if(RTOS_BUILD_FIRMWARE OR NOT RTOS_LWIP OR NOT CMAKE_CXX_COMPILER_ID MATCHES "Clang")
    message(FATAL_ERROR "Service fuzzing requires native Clang and RTOS_LWIP")
  endif()
  add_compile_options(-fsanitize=fuzzer-no-link)
endif()
option(RTOS_SERVICE_COVERAGE "Instrument optional services and tests with gcov" OFF)
if(RTOS_SERVICE_COVERAGE)
  if(RTOS_BUILD_FIRMWARE OR NOT CMAKE_CXX_COMPILER_ID STREQUAL "GNU")
    message(FATAL_ERROR "Service coverage requires native GNU compilation")
  endif()
  add_compile_options(--coverage -O0 -g)
  add_link_options(--coverage)
endif()
if(RTOS_LWIP AND NOT RTOS_ETHERNET)
  message(FATAL_ERROR "RTOS_LWIP requires RTOS_ETHERNET")
endif()
option(RTOS_SYNC "Build synchronization services" OFF)
option(RTOS_ZAAMO "Use optional RISCue hardware word RMWs" OFF)
option(RTOS_ZAAMO_CAPABLE_RAM "BSP explicitly guarantees native atomic-capable RAM" OFF)
if(RTOS_ZAAMO)
  if(NOT RTOS_BUILD_FIRMWARE OR NOT RTOS_TARGET_ID STREQUAL "riscue")
    message(FATAL_ERROR "RTOS_ZAAMO requires RISCue firmware; other HAL providers remain independent")
  endif()
  if(NOT RTOS_SYNC OR NOT RTOS_ZAAMO_CAPABLE_RAM)
    message(FATAL_ERROR "RTOS_ZAAMO requires RTOS_SYNC and explicit RTOS_ZAAMO_CAPABLE_RAM; the AXI bridge is not capable")
  endif()
endif()
option(RTOS_DMA "Build portable boot-static DMA channel support" OFF)
if(RTOS_DMA AND NOT RTOS_SYNC)
  message(FATAL_ERROR "RTOS_DMA requires RTOS_SYNC for thread caller serialization")
endif()
if(RTOS_STORAGE AND NOT EXISTS "${CMAKE_SOURCE_DIR}/src/storage.cpp")
  message(FATAL_ERROR "Storage implementation is not integrated yet")
endif()
if(RTOS_SYNC AND NOT EXISTS "${CMAKE_SOURCE_DIR}/include/rtos_sync.hpp")
  message(FATAL_ERROR "Synchronization implementation is not integrated yet")
endif()

set(RTOS_IPC_MAX_MESSAGE_BYTES 128 CACHE STRING "Maximum copied IPC payload in bytes")

set(RTOS_MAX_HELD_MUTEXES 8 CACHE STRING "Maximum simultaneously held mutexes per thread")

option(RTOS_LOGGING "Build bounded queued printf formatter" OFF)
if(RTOS_LOGGING AND NOT RTOS_SYNC)
  message(FATAL_ERROR "RTOS_LOGGING requires RTOS_SYNC")
endif()
# These values become C++ literals. Reject leading zeroes (octal), expressions,
# lists and oversized input at configure time, before compiler diagnostics.
function(rtos_decimal key minimum maximum)
  if(NOT "${${key}}" MATCHES "^[1-9][0-9]*$")
    message(FATAL_ERROR "${key} must be decimal ${minimum}..${maximum}, without leading zeroes")
  endif()
  string(LENGTH "${${key}}" digits)
  if(digits GREATER 10)
    message(FATAL_ERROR "${key} exceeds ${maximum}")
  endif()
  if(${${key}} LESS ${minimum} OR ${${key}} GREATER ${maximum})
    message(FATAL_ERROR "${key} must be ${minimum}..${maximum}")
  endif()
endfunction()
rtos_decimal(RTOS_MAX_THREADS 1 255)
rtos_decimal(RTOS_TICK_HZ 1 4294967295)
rtos_decimal(RTOS_IDLE_STACK_BYTES 512 4294967280)
rtos_decimal(RTOS_BOOT_STACK_BYTES 512 32512)
math(EXPR boot_remainder "${RTOS_BOOT_STACK_BYTES} % 16")
if(NOT boot_remainder EQUAL 0)
  message(FATAL_ERROR "RTOS_BOOT_STACK_BYTES must be a multiple of 16")
endif()
rtos_decimal(RTOS_IPC_MAX_MESSAGE_BYTES 1 512)
rtos_decimal(RTOS_MAX_HELD_MUTEXES 1 255)
math(EXPR idle_remainder "${RTOS_IDLE_STACK_BYTES} % 16")
if(NOT idle_remainder EQUAL 0)
  message(FATAL_ERROR "RTOS_IDLE_STACK_BYTES must be a multiple of 16")
endif()
