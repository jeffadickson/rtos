option(RTOS_BUILD_FIRMWARE "Build RV32 firmware (requires toolchain file)" OFF)
option(RTOS_ROUND_ROBIN "Time-slice equal priorities on ticks" ON)
option(RTOS_METRICS "Collect runtime cycles and dispatch counts" ON)
option(RTOS_STACK_GUARD "Check stack-bottom sentinels on dispatch" ON)
option(RTOS_ETHERNET "Build static polling Ethernet adapter" ON)
set(RTOS_MAX_THREADS 16 CACHE STRING "Maximum application threads, excluding idle")
set(RTOS_TICK_HZ 1000 CACHE STRING "Default tick rate")
set(RTOS_IDLE_STACK_BYTES 1024 CACHE STRING "Idle stack size")
set(RTOS_MTIME_ADDRESS 0x0200bff8 CACHE STRING "mtime MMIO address")
set(RTOS_MTIMECMP_ADDRESS 0x02004000 CACHE STRING "mtimecmp MMIO address")

option(RTOS_WEB "Build bounded read-only HTTP component" ON)
option(RTOS_STORAGE "Build flash storage service" OFF)
option(RTOS_SYNC "Build synchronization services" OFF)
if(RTOS_STORAGE AND NOT EXISTS "${CMAKE_SOURCE_DIR}/src/storage.cpp")
  message(FATAL_ERROR "Storage implementation is not integrated yet")
endif()
if(RTOS_SYNC AND NOT EXISTS "${CMAKE_SOURCE_DIR}/include/rtos_sync.hpp")
  message(FATAL_ERROR "Synchronization implementation is not integrated yet")
endif()

set(RTOS_IPC_MAX_MESSAGE_BYTES 128 CACHE STRING "Maximum copied IPC payload in bytes")

set(RTOS_MAX_HELD_MUTEXES 8 CACHE STRING "Maximum simultaneously held mutexes per thread")
