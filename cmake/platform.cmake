# Run before project() so an unimplemented target cannot select an unrelated compiler.
set(RTOS_TARGET_ID riscue CACHE STRING "Target catalogue identity")
set(RTOS_CPU_COUNT 1 CACHE STRING "Participating CPUs (current kernel supports one)")
set(RTOS_MULTIPROCESSING up CACHE STRING "up; future amp/smp")
set_property(CACHE RTOS_MULTIPROCESSING PROPERTY STRINGS up amp smp)
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/../config/system.json")
file(READ "${CMAKE_CURRENT_LIST_DIR}/../config/system.json" NXR_CATALOGUE)
string(JSON NXR_TARGET_COUNT LENGTH "${NXR_CATALOGUE}" targets)
math(EXPR NXR_TARGET_LAST "${NXR_TARGET_COUNT} - 1")
set(NXR_TARGET_FOUND FALSE)
foreach(index RANGE 0 ${NXR_TARGET_LAST})
  string(JSON candidate GET "${NXR_CATALOGUE}" targets ${index} id)
  if(candidate STREQUAL RTOS_TARGET_ID)
    set(NXR_TARGET_FOUND TRUE)
    string(JSON NXR_PORT_READY GET "${NXR_CATALOGUE}" targets ${index} firmwareReady)
  endif()
endforeach()
if(NOT NXR_TARGET_FOUND)
  message(FATAL_ERROR "Unknown RTOS_TARGET_ID '${RTOS_TARGET_ID}'; use NexRT.Configure list")
endif()
if(NOT RTOS_CPU_COUNT STREQUAL "1" OR NOT RTOS_MULTIPROCESSING STREQUAL "up")
  message(FATAL_ERROR "AMP/SMP is planned; current kernel requires RTOS_CPU_COUNT=1 and RTOS_MULTIPROCESSING=up")
endif()
if(RTOS_BUILD_FIRMWARE AND NOT NXR_PORT_READY)
  message(FATAL_ERROR "Target '${RTOS_TARGET_ID}' is a planned port. Context/startup, BSP, linker and target qualification are not implemented; firmware generation is disabled.")
endif()
