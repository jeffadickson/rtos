set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR riscv32)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)
set(RISCV_TOOLCHAIN_PREFIX "riscv64-unknown-elf-" CACHE STRING "Toolchain prefix, optionally absolute")
set(CMAKE_CXX_COMPILER "${RISCV_TOOLCHAIN_PREFIX}g++")
set(CMAKE_ASM_COMPILER "${RISCV_TOOLCHAIN_PREFIX}gcc")
set(CMAKE_NM "${RISCV_TOOLCHAIN_PREFIX}nm" CACHE FILEPATH "nm")
set(CMAKE_SIZE "${RISCV_TOOLCHAIN_PREFIX}size" CACHE FILEPATH "size")
set(RISCV_FLAGS "-march=rv32im_zicsr -mabi=ilp32 -mcmodel=medlow -mno-relax -msmall-data-limit=0 -ffreestanding -fno-builtin -fno-pic -fno-stack-protector")
set(CMAKE_CXX_FLAGS_INIT "${RISCV_FLAGS} -fno-exceptions -fno-rtti -fno-threadsafe-statics -fno-use-cxa-atexit")
set(CMAKE_ASM_FLAGS_INIT "${RISCV_FLAGS}")
